<!DOCTYPE html>
<html lang="en">

    <head>
        <meta charset="UTF-8" />
        <title>
            <%= title %>
        </title>

        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="stylesheet" href="/css/main.css" />
    </head>

    <body>
        <nav>
            <ul>
                
                <li><a href="/">Home</a></li>
                <li><a href="/organizations">Organizations</a></li>
                <li><a href="/projects">Projects</a></li>
                <li><a href="/categories">Categories</a></li>

                <% if (isLoggedIn) { %>
                    
                    <li><a href="/dashboard">Dashboard</a></li>

                    <% if (user && user.role_name==='admin' ) { %>
                        <!-- ADMIN-ONLY LINKS -->
                        <li><a href="/users">Users</a></li>
                        <li><a href="/new-organization">Add Organization</a></li>
                        <li><a href="/new-project">Add Project</a></li>
                        <li><a href="/new-category">Add Category</a></li>
                        <% } %>

                            
                            <li><a href="/logout">Logout</a></li>

                            <% } else { %>
                                
                                <li><a href="/register">Register</a></li>
                                <li><a href="/login">Login</a></li>
                                <% } %>
            </ul>
        </nav>

        <% const messages=flash(); %>
            <% Object.keys(messages).forEach(type=> { %>
                <% if (messages[type].length> 0) { %>
                    <div class="alert <%= type %>">
                        <% messages[type].forEach(msg=> { %>
                            <p>
                                <%= msg %>
                            </p>
                            <% }) %>
                    </div>
                    <% } %>
                        <% }) %>

                            <button id="darkModeToggle" class="floating-toggle" aria-label="Toggle dark mode">
                                🌙
                            </button>