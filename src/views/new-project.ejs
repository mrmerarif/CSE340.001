<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <% const formErrors=(typeof errors !=='undefined' && Array.isArray(errors)) ? errors : []; %>

            <% if (formErrors.length> 0) { %>
                <div class="alert error">
                    <ul>
                        <% formErrors.forEach(err=> { %>
                            <li>
                                <%= err.msg %>
                            </li>
                            <% }) %>
                    </ul>
                </div>
                <% } %>

                    <% const values=(typeof project !=='undefined' && project) ? project : {}; %>

                        <section class="new-project-form">
                            <form action="/new-project" method="POST">

                                <div class="form-group">
                                    <label>Project Title</label>
                                    <input type="text" name="title" required value="<%= values.title || '' %>">
                                </div>

                                <div class="form-group">
                                    <label>Description</label>
                                    <textarea name="description" required><%= values.description || '' %></textarea>
                                </div>

                                <div class="form-group">
                                    <label>Location</label>
                                    <input type="text" name="location" required value="<%= values.location || '' %>">
                                </div>

                                <div class="form-group">
                                    <label>Date</label>
                                    <input type="date" name="date" required value="<%= values.date || '' %>">
                                </div>

                                <div class="form-group">
                                    <label>Organization</label>

                                    <!-- IMPORTANT: must match controller -->
                                    <select name="organization_id" required>
                                        <option value="">Select organization</option>

                                        <% if (typeof organizations !=='undefined' ) { %>
                                            <% organizations.forEach(org=> { %>
                                                <option value="<%= org.organization_id %>">
                                                    <%= org.name %>
                                                </option>
                                                <% }) %>
                                                    <% } %>

                                    </select>
                                </div>

                                <button type="submit">Create Project</button>

                            </form>
                        </section>
    </main>

    <%- include('partials/footer') %>