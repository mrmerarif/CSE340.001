<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <section class="new-project-form">
            <form action="/new-project" method="POST">

                <div class="form-group">
                    <label for="title">Project Title</label>
                    <input type="text" id="title" name="title" class="form-input" required maxlength="150" />
                </div>

                <div class="form-group">
                    <label for="description">Description</label>
                    <textarea id="description" name="description" class="form-textarea" required
                        maxlength="500"></textarea>
                </div>

                <div class="form-group">
                    <label for="location">Location</label>
                    <input type="text" id="location" name="location" class="form-input" required maxlength="255" />
                </div>

                <div class="form-group">
                    <label for="date">Date</label>
                    <input type="date" id="date" name="date" class="form-input" required />
                </div>

                <div class="form-group">
                    <label for="organizationId">Organization</label>
                    <select id="organizationId" name="organizationId" class="form-input" required>
                        <option value="">Select an organization</option>

                        <% organizations.forEach(org=> { %>
                            <option value="<%= org.organization_id %>">
                                <%= org.name %>
                            </option>
                            <% }) %>
                    </select>
                </div>

                <button type="submit" class="form-submit">Create Project</button>
            </form>
        </section>
    </main>

    <%- include('partials/footer') %>