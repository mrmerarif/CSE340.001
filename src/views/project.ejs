<%- include("partials/header") %>

    <main>
        <h1>
            <%= project.title %>
        </h1>

        <p><strong>Description:</strong>
            <%= project.description %>
        </p>

        <p>
            <strong>Date:</strong>
            <% const dateObj=new Date(project.date); const formattedDate=dateObj.toLocaleDateString('en-US', {
                year: 'numeric' , month: 'short' , day: 'numeric' }); %>
                <%= formattedDate %>
        </p>

        <p><strong>Location:</strong>
            <%= project.location %>
        </p>

        <p>
            <strong>Organization:</strong>
            <a href="/organization/<%= project.organization_id %>">
                <%= project.organization_name %>
            </a>
        </p>

        <!-- NEW: Category tags -->
        <section class="project-categories">
            <strong>Categories:</strong>

            <% if (categories && categories.length> 0) { %>
                <ul>
                    <% categories.forEach(cat=> { %>
                        <li>
                            <a href="/category/<%= cat.category_id %>">
                                <%= cat.name %>
                            </a>
                        </li>
                        <% }) %>
                </ul>
                <% } else { %>
                    <p>No categories listed for this project.</p>
                    <% } %>

                        <!-- NEW: Edit Categories link -->
                        <p>
                            <a href="/assign-categories/<%= project.project_id %>">
                                Edit Categories
                            </a>
                        </p>
        </section>

        <p>
            <a href="/projects">← Back to Upcoming Service Projects</a>
        </p>
    </main>

    <%- include("partials/footer") %>