<%- include("partials/header") %>

    <main>
        <h1>
            <%= project.title %>
        </h1>

        <p>
            <strong>Description:</strong>
            <%= project.description %>
        </p>

        <p>
            <strong>Date:</strong>
            <% const dateObj=new Date(project.date); const formattedDate=dateObj.toLocaleDateString('en-US', {
                year: 'numeric' , month: 'short' , day: 'numeric' }); %>
                <%= formattedDate %>
        </p>

        <p>
            <strong>Location:</strong>
            <%= project.location %>
        </p>

        <p>
            <strong>Organization:</strong>
            <a href="/organization/<%= project.organization_id %>">
                <%= project.organization_name %>
            </a>
        </p>

        <!-- ✅ Volunteer Section (CORRECT) -->
        <section class="volunteer-section">
            <% if (user) { %>

                <% if (isVolunteering) { %>
                    <p><strong>You are volunteering for this project.</strong></p>

                    <a href="/project/<%= project.project_id %>/unvolunteer" class="btn btn-danger">
                        Remove me as a volunteer
                    </a>

                    <% } else { %>
                        <a href="/project/<%= project.project_id %>/volunteer" class="btn">
                            Volunteer for this project
                        </a>
                        <% } %>

                            <% } else { %>
                                <p>
                                    <a href="/login">Log in</a> to volunteer for this project.
                                </p>
                                <% } %>
        </section>

        <!-- Categories -->
        <section class="project-categories">
            <strong>Categories:</strong>

            <% if (categories && categories.length> 0) { %>
                <ul>
                    <% categories.forEach(cat=> { %>
                        <li>
                            <a href="/category/<%= cat.category_id %>">
                                <%= cat.name %>
                            </a>
                        </li>
                        <% }) %>
                </ul>
                <% } else { %>
                    <p>No categories listed for this project.</p>
                    <% } %>

                        <!-- ✅ Admin ONLY actions -->
                        <% if (user && user.role_name==='admin' ) { %>

                            <p>
                                <a href="/assign-categories/<%= project.project_id %>">
                                    Edit Categories
                                </a>
                            </p>

                            <p>
                                <a href="/edit-project/<%= project.project_id %>">
                                    Edit Project
                                </a>
                            </p>

                            <% } %>
        </section>

        <p>
            <a href="/projects">← Back to Upcoming Service Projects</a>
        </p>
    </main>

    <%- include("partials/footer") %>