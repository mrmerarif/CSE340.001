<%- include("partials/header") %>

    <main class="page page-categories">
        <h1>
            <%= title %>
        </h1>

        <section class="organizations-list">
            <h2 class="section-title">Service Project Categories</h2>

            <ul>
                <% categories.forEach(category=> { %>
                    <li>
                        <a href="/category/<%= category.category_id %>">
                            <%= category.name %>
                        </a>
                    </li>
                    <% }) %>
            </ul>
        </section>

        <% if (user && user.role_name==='admin' ) { %>
            <p>
                <a href="/new-category" class="form-submit">Add New Category</a>
            </p>
            <% } %>
    </main>

    <%- include("partials/footer") %>