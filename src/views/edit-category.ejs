<%- include('partials/header') %>

    <main class="page page-category-edit">
        <h1>
            <%= title %>
        </h1>

        <!-- Display server-side validation errors -->
        <% if (errors && errors.length> 0) { %>
            <div class="alert error">
                <ul>
                    <% errors.forEach(err=> { %>
                        <li>
                            <%= err.msg %>
                        </li>
                        <% }) %>
                </ul>
            </div>
            <% } %>

                <section class="edit-category-form">
                    <form action="/edit-category/<%= categoryId %>" method="POST" class="form-container">

                        <div class="form-group">
                            <label for="name">Category Name</label>
                            <input type="text" id="name" name="name" class="form-input" required maxlength="100"
                                value="<%= (values && values.name) || '' %>" />
                        </div>

                        <button type="submit" class="form-submit">Update Category</button>
                    </form>
                </section>

                <p>
                    <a href="/category/<%= categoryId %>">← Back to Category</a>
                </p>
    </main>

    <%- include('partials/footer') %>