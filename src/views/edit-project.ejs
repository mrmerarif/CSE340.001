<%- include("partials/header") %>

    <main>
        <h1>Edit Project: <%= project.title %>
        </h1>

        <form action="/edit-project/<%= project.project_id %>" method="POST">

            <label for="title">Title</label>
            <input type="text" id="title" name="title" value="<%= project.title %>" required>

            <label for="description">Description</label>
            <textarea id="description" name="description" required><%= project.description %></textarea>

            <label for="location">Location</label>
            <input type="text" id="location" name="location" value="<%= project.location %>" required>

            <label for="date">Date</label>
            <input type="date" id="date" name="date" value="<%= project.date.toISOString().split('T')[0] %>" required>

            <label for="organizationId">Organization</label>
            <select id="organizationId" name="organizationId" required>
                <% organizations.forEach(org=> { %>
                    <option value="<%= org.organization_id %>" <%=org.organization_id===project.organization_id
                        ? "selected" : "" %>
                        >
                        <%= org.name %>
                    </option>
                    <% }) %>
            </select>

            <button type="submit">Save Changes</button>
        </form>

        <p>
            <a href="/project/<%= project.project_id %>">← Back to Project Details</a>
        </p>
    </main>

    <%- include("partials/footer") %>