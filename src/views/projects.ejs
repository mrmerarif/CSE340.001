<%- include("partials/header") %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <section class="organizations-list">
            <h2 class="section-title">Upcoming Service Projects</h2>

            <% if (projects && projects.length> 0) { %>
                <ul>
                    <% projects.forEach(project=> { %>
                        <li>
                            <% const dateObj=new Date(project.date); const
                                formattedDate=dateObj.toLocaleDateString('en-US', { year: 'numeric' , month: 'short' ,
                                day: 'numeric' }); %>

                                <%= formattedDate %>:
                                    <a href="/project/<%= project.project_id %>">
                                        <%= project.title %>
                                    </a>
                                    (
                                    <a href="/organization/<%= project.organization_id %>">
                                        <%= project.organization_name %>
                                    </a>
                                    )
                        </li>
                        <% }) %>
                </ul>
                <% } else { %>
                    <p>No projects found.</p>
                    <% } %>
        </section>

        <p>
            <!-- UPDATED: added action-button class -->
            <a href="/new-project" class="action-button">Add a New Service Project</a>
        </p>

    </main>

    <%- include("partials/footer") %>