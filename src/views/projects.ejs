<%- include("partials/header") %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <section class="organizations-list">
            <h2 class="section-title">Upcoming Service Projects</h2>

            <% if (projects && projects.length> 0) { %>
                <ul>
                    <% projects.forEach(project=> { %>
                        <li>
                            <% const dateObj=new Date(project.date); const
                                formattedDate=dateObj.toLocaleDateString('en-US', { year: 'numeric' , month: 'short' ,
                                day: 'numeric' }); %>
                                <%= formattedDate %>: <%= project.title %> (<%= project.organization_name %>)
                        </li>
                        <% }) %>
                </ul>
                <% } else { %>
                    <p>No projects found.</p>
                    <% } %>
        </section>
    </main>

    <%- include("partials/footer") %>