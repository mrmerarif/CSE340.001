<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <section class="organization-details">
            <h2 class="organization-name">
                <%= organizationDetails.name %>
            </h2>

            <img src="/images/<%= organizationDetails.logo_filename %>" alt="<%= organizationDetails.name %> logo"
                class="organization-logo">

            <p class="organization-description">
                <strong>Description:</strong>
                <%= organizationDetails.description %>
            </p>
        </section>

        <section class="organization-projects">
            <h3>Service Projects</h3>

            <ul class="project-list">
                <% projects.forEach(project=> { %>
                    <li class="project-item">
                        <a href="/project/<%= project.project_id %>">
                            <%= project.title %>
                        </a>
                    </li>
                    <% }) %>
            </ul>
            <p><a href="/edit-organization/<%= organizationDetails.organization_id %>">Edit Organization</a></p>

        </section>
    </main>

    <%- include('partials/footer') %>